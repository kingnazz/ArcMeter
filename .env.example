# Client-safe Supabase settings. Never place the service-role key in a desktop build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-client-safe-anon-or-publishable-key

# The native layer reads the same client-safe values during Tauri builds.
ARCMETER_SUPABASE_URL=https://your-project.supabase.co
ARCMETER_SUPABASE_ANON_KEY=your-client-safe-anon-or-publishable-key

# Development-only diagnostics. Production analytics are never populated with demo data.
VITE_ARCMETER_DIAGNOSTICS=false
